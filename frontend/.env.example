# ==============================================================
# Frontend Environment Configuration (.env.example)
# Rename this file to .env or set in Vercel/Netlify Environment Variables.
# ==============================================================

# URL of your deployed Spring Boot backend API (include /api)
# Local development:
# VITE_API_URL=http://localhost:8080/api

# Production (e.g. Render/Railway):
VITE_API_URL=https://your-backend-app.onrender.com/api

