# ==============================================================
# Backend Environment Configuration (.env.example)
# Rename this file to .env or set these in your cloud platform
# (e.g., Render, Railway, AWS ECS) Environment Variables dashboard.
# ==============================================================

# Server Port (Render & Railway inject PORT automatically)
PORT=8080

# Production Database (e.g. from Aiven, Railway MySQL, or Supabase/AWS RDS)
SPRING_DATASOURCE_URL=jdbc:mysql://your-cloud-mysql-host:3306/community_service_db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=cloud_user
SPRING_DATASOURCE_PASSWORD=your_strong_cloud_password

# Database DDL Mode
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Secret Key for JWT Signing (Must be at least 256-bit string)
JWT_SECRET=campusserve-jwt-secret-key-for-local-development-only-replace-in-production
JWT_EXPIRATION_MS=86400000

# Allowed CORS Origins (Comma-separated exact URLs or wildcards)
# Add your deployed frontend URL here!
CORS_ALLOWED_ORIGINS=https://campusserve.vercel.app,http://localhost:5173,http://localhost:3000,https://*.vercel.app,https://*.netlify.app

